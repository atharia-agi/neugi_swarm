# .vercelignore — what Vercel must NOT deploy to neugi.com
#
# The public site is a static site: HTML pages, assets, installers, and
# site metadata only. Everything else (Python source, scripts, specs,
# session transcripts, tooling) stays out of the deployment.
# Canonical host is Vercel (see neugi_swarm_v2/docs/DEPLOYMENT.md).
# The GitHub Pages workflow ships the same file set as a mirror.

# Application source (the whole Python framework)
neugi_swarm_v2/

# Runtime data — session transcripts were publicly reachable before this fix
sessions/

# Build / test / lint tooling and scripts
scripts/
audit/
tests/
.pytest_cache/
.ruff_cache/
.mypy_cache/
__pycache__/
*.pyc
*.log

# Repo tooling and specs (not part of the site)
.github/
.kiro/
AGENTS.md
NEXT_STEPS.md
RELEASE_CHECKLIST_WEB.md
docs-claims-contract.md
git_files_browser.py
objects.txt
OLLAMA_EMAIL.txt
package.json
pyproject.toml
requirements.txt

# Files kept in the repo but not needed on the site
neugi-dashboard-shipping-grade.png
